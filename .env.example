# Copy this file to .env for local development. Never commit the real .env.
# In production (Render), set these as environment variables in the
# dashboard instead — don't put real secrets in this file or in git.

# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks
# (or from `stripe listen` when testing locally with the Stripe CLI)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified sender on your Resend account/domain. Until you verify
# aarongregorydesign.com in Resend, onboarding@resend.dev works for testing.
RESEND_FROM="Fast Stickers <onboarding@resend.dev>"

# Where order notifications are sent
NOTIFY_EMAIL=aaron@aarongregorydesign.com

PORT=3000
